{
  // Cloudflare Worker 설정
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thebarrel-music",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",

  // public/ 폴더의 파일(스타일, 관리자 화면)은 Worker를 거치지 않고 바로 전달된다 (무료, 요청 수 미포함)
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },

  // 사진·영상·홈페이지 내용·완성된 홈페이지 HTML을 저장하는 R2 버킷
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "thebarrel-media" }
  ],

  "observability": { "enabled": true }
}
